  "@types/react": "^19.2.0",
  "@types/react-dom": "^19.2.0",
  "@vitejs/plugin-react": "^6.1.2",
  "typescript": "^5.9.0",
  "vite": "^7.0.0",
  "vitest": "^5.0.3"
 }
}
