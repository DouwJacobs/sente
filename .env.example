# Published image: pinned version or digest recommended; channels main/latest and beta/development
SENTE_IMAGE=douwjacobs/sente:latest
# Source build metadata: generate with python3 scripts/release-metadata.py --output env
SENTE_VERSION=dev
SENTE_COMMIT=
SENTE_BUILD_TIME=
PUBLIC_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
# Exact IPs/CIDRs of proxy hops as seen by the Go server; empty trusts no headers.
# Native same-host proxy: 127.0.0.1/32,::1/128
# Docker host proxy: use its actual bridge gateway IP, not this loopback example.
TRUSTED_PROXIES=
# Native binary only; Compose listens on its container interface.
LISTEN_ADDRESS=127.0.0.1

# Optional starter configuration source; pulls occur only when requested in Settings.
SENTE_DEFAULT_CONFIG_REPOSITORY=https://github.com/DouwJacobs/sente-config.git
SENTE_DEFAULT_CONFIG_REF=
SENTE_DEFAULT_CONFIG_PATH=sente.json
