# Docker image channel: latest or development
SENTE_TAG=latest
PUBLIC_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
# Exact IPs/CIDRs of proxy hops as seen by the Go server; empty trusts no headers.
# Native same-host proxy: 127.0.0.1/32,::1/128
# Docker host proxy: use its actual bridge gateway IP, not this loopback example.
TRUSTED_PROXIES=
# Native binary only; Compose listens on its container interface.
LISTEN_ADDRESS=127.0.0.1
